# Optional environment variables; set these in PowerShell or copy to .env.
RTM_TARGET_GAMES=400
RTM_DATABASE=data/market.sqlite
RTM_REQUEST_INTERVAL=1.5
RTM_DISCOVERY_PAGES=6
RTM_DISCOVERY_COUNTRY=all
RTM_DISCOVERY_DEVICE=computer
# VPS compatibility option: urllib (same APIs, TLS validation and retry rules).
RTM_HTTP_TRANSPORT=httpx
# Optional manually supplied universe IDs, never place IDs.
RTM_SEED_IDS=
