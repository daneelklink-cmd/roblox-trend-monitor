[Unit]
Description=Roblox hourly market collection and reports
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roblox-monitor
Group=roblox-monitor
WorkingDirectory=/opt/roblox-trend-monitor
EnvironmentFile=/etc/roblox-trend-monitor.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/var/lib/roblox-trend-monitor
ExecStart=/opt/roblox-trend-monitor/.venv/bin/python -m app.scheduler
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/roblox-trend-monitor /opt/roblox-trend-monitor/data /opt/roblox-trend-monitor/reports
UMask=0027

[Install]
WantedBy=multi-user.target
